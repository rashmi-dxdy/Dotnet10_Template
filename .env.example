# Copy to `.env` and fill in real values. `.env` is git-ignored - never commit it.
# Docker Compose reads `.env` automatically from this directory.
# All values below are LOCAL DEVELOPMENT PLACEHOLDERS, not real credentials.
#
# `docker compose up --build` needs every value marked REQUIRED below. Compose stops with
# "required variable ... is missing a value" if one is empty. See README.md, "Docker".

# ---------------------------------------------------------------------------
# ASP.NET Core
# ---------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development

# Host port of the app container (http://localhost:8080). Inside the container the app listens on 8080.
APP_PORT=8080

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# CURRENT PHASE: all modules share ONE database. Each module owns only the tables with its
# prefix (Catalog CAT_, Orders ORD_, Notifications NTF_). Each module still has its own
# connection string (ConnectionStrings__CatalogDb, __OrdersDb, __NotificationsDb), all pointing
# at this database for now, so a module can move to its own database later by changing only
# its connection string. See docs/database.md.
#
# In Docker Compose the app connects to Host=postgres;Port=5432. Port 5432 is NOT published to the
# host. POSTGRES_HOST / POSTGRES_PORT only describe a PostgreSQL you run yourself outside Compose.
#
# Server administrator (container superuser) - used only to create the app database and login. REQUIRED.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# The shared application database and the login the application uses. REQUIRED.
# docker/postgres/init.sh creates them on the FIRST start of an empty postgres_data volume only.
APP_DB_NAME=dotnet10template
APP_DB_USER=app
APP_DB_PASSWORD=change-me-app

# ---------------------------------------------------------------------------
# RabbitMQ
# ---------------------------------------------------------------------------
# Docker Compose passes these to the application as RabbitMq__Host, RabbitMq__Port,
# RabbitMq__VirtualHost, RabbitMq__Username and RabbitMq__Password. See docs/messaging.md.
# In Docker Compose the app connects to rabbitmq:5672, which is NOT published to the host; only the
# management UI is (http://localhost:15672, log in with RABBITMQ_USER / RABBITMQ_PASSWORD).
# RABBITMQ_HOST / RABBITMQ_PORT only describe a broker you run yourself outside Compose.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_VHOST=/
# REQUIRED. Compose creates this user on the first start of an empty rabbitmq_data volume.
RABBITMQ_USER=app
RABBITMQ_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Apache Kafka
# ---------------------------------------------------------------------------
# Independent of RabbitMQ. Docker Compose passes these to the application as Kafka__BootstrapServers,
# Kafka__SecurityProtocol, Kafka__SaslUsername and Kafka__SaslPassword. Each module consumes in its own
# consumer group (the module name, set in code). See docs/streaming.md.
#
# In Docker Compose the app connects to kafka:9092 (INTERNAL listener, not published). Tools on your
# machine use the EXTERNAL listener: localhost:9094.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_EXTERNAL_PORT=9094
KAFKA_SECURITY_PROTOCOL=Plaintext
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# KRaft cluster ID of the Compose broker. REQUIRED. Generate ONCE and never change it: Kafka refuses to
# start when it differs from the ID stored in the kafka_data volume.
#   docker run --rm apache/kafka:3.9.0 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=

# ---------------------------------------------------------------------------
# Modules (modular monolith) - see docs/modules.md
# ---------------------------------------------------------------------------
# Every module runs in the one application by default. To extract a module, deploy the same
# application again with Modules__<Module>__Enabled=false for the others, and on the original
# deployment set Modules__<Module>__Enabled=false and Modules__<Module>__BaseAddress=<its URL>.
#
# Shared key for the internal module APIs (/internal/<module>/...). If EMPTY, a random key is
# generated per process, which works while every module runs in the one app container. Recommended
# for Docker Compose (stable across restarts); required, and identical everywhere, once modules run in
# more than one process. At least 32 characters: openssl rand -hex 32
INTERNAL_API_KEY=

# ---------------------------------------------------------------------------
# Serilog
# ---------------------------------------------------------------------------
# Passed to the application by Docker Compose as Serilog__MinimumLevel__Default
# (Verbose, Debug, Information, Warning, Error, Fatal). See docs/logging.md.
SERILOG_MINIMUM_LEVEL=Information
