# Copy to `.env` and fill in real values. `.env` is git-ignored - never commit it.
# Docker Compose reads `.env` automatically from this directory.
# All values below are LOCAL DEVELOPMENT PLACEHOLDERS, not real credentials.

# ---------------------------------------------------------------------------
# ASP.NET Core
# ---------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# CURRENT PHASE: all services share ONE database. Each service owns only the tables with its
# prefix (Catalog CAT_, Orders ORD_, Notifications NTF_). Each service still has its own
# connection string (ConnectionStrings__CatalogDb, __OrdersDb, __NotificationsDb), all pointing
# at this database for now, so a service can move to its own database later by changing only
# its connection string. See docs/database.md.
#
# Server administrator (container superuser) - used only to create the app database and login.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# The shared application database and the login the services use.
APP_DB_NAME=dotnet10template
APP_DB_USER=app
APP_DB_PASSWORD=change-me-app

# ---------------------------------------------------------------------------
# RabbitMQ
# ---------------------------------------------------------------------------
# Docker Compose passes these to every service as RabbitMq__Host, RabbitMq__Port,
# RabbitMq__VirtualHost, RabbitMq__Username and RabbitMq__Password. See docs/messaging.md.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_VHOST=/
RABBITMQ_USER=app
RABBITMQ_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Apache Kafka
# ---------------------------------------------------------------------------
# Independent of RabbitMQ. Docker Compose passes these to every service as Kafka__BootstrapServers,
# Kafka__SecurityProtocol, Kafka__SaslUsername and Kafka__SaslPassword. The consumer group is per
# service (Kafka__Consumer__GroupId, set in each appsettings.json). See docs/streaming.md.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=Plaintext
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ---------------------------------------------------------------------------
# Serilog
# ---------------------------------------------------------------------------
# Passed to every service by Docker Compose as Serilog__MinimumLevel__Default
# (Verbose, Debug, Information, Warning, Error, Fatal). See docs/logging.md.
SERILOG_MINIMUM_LEVEL=Information
