<Project>

  <!--
    Common settings imported automatically by every project under this folder.
    Individual projects should only override these when they have a specific reason.
  -->

  <PropertyGroup Label="Language and framework">
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Label="Code quality">
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Enable every compiler warning wave available in the current SDK. -->
    <WarningLevel>9999</WarningLevel>
    <!-- Run IDE code-style rules (IDExxxx) during command-line builds, not only in the editor. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!--
      Required for IDE0005 (unnecessary usings) to run during build, and validates XML doc comments
      that ARE written. Missing docs (CS1591) is not enforced - see .editorconfig.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <!--
      NuGet audit: low/moderate advisories stay as warnings so a newly published advisory
      on a transitive dependency doesn't break every build. High/critical still fail.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="Build reproducibility">
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    Docker development container only (docker/Dockerfile.dev sets CONTAINER_BUILD_ROOT). The repository is
    bind-mounted from the developer's machine, so bin/ and obj/ go to a container-only folder instead.
    Otherwise the Linux restore would overwrite the host's obj/project.assets.json (and the reverse), breaking
    builds in Visual Studio and Rider. The host's own bin/ and obj/ folders are excluded from the items, because
    the default exclusions now point at the container folder.
    Not set anywhere else, so local, IDE and CI builds are unaffected.
  -->
  <PropertyGroup Label="Docker dev container" Condition="'$(CONTAINER_BUILD_ROOT)' != ''">
    <BaseIntermediateOutputPath>$(CONTAINER_BUILD_ROOT)/$(MSBuildProjectName)/obj/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(CONTAINER_BUILD_ROOT)/$(MSBuildProjectName)/bin/</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- CI-only: normalise source paths in PDBs and enable deterministic CI behaviour. -->
  <PropertyGroup Label="CI" Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true' or '$(TF_BUILD)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
