<Project>

  <!--
    NuGet Central Package Management.
    Every package version lives here. Project files reference packages WITHOUT a Version attribute:
      <PackageReference Include="Serilog.AspNetCore" />
    Versions verified as latest stable on nuget.org on 2026-11-06.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Also pin transitive dependencies to the versions below when they appear in the graph. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Analyzers applied to EVERY project (GlobalPackageReference = implicit PackageReference with
    PrivateAssets="all", so they never flow to consumers). Severities are configured in .editorconfig.
    StyleCop.Analyzers: 1.1.118 is the latest STABLE release (2019); 1.2+/1.3 are still beta. Only its
    non-overlapping rule categories are enabled - see .editorconfig.
  -->
  <ItemGroup Label="Analyzers (all projects)">
    <GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.321" />
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="5.0.1" />
    <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
    <GlobalPackageReference Include="StyleCop.Analyzers" Version="1.1.118" />
  </ItemGroup>

  <ItemGroup Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="ASP.NET Core">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Data access - EF Core and PostgreSQL">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Logging - Serilog">
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup Label="Messaging - RabbitMQ and Kafka">
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageVersion Include="Confluent.Kafka" Version="2.16.0" />
  </ItemGroup>

  <ItemGroup Label="Health checks">
    <!-- No 10.x release yet; 9.0.0 targets net8.0+ and runs on .NET 10. -->
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Rabbitmq" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Kafka" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- xUnit v3 on Microsoft.Testing.Platform; see "test" in global.json. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
