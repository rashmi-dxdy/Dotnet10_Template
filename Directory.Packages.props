<Project>

  <!--
    NuGet Central Package Management.
    Every package version lives here. Project files reference packages WITHOUT a Version attribute:
      <PackageReference Include="Serilog.AspNetCore" />
    Versions verified as latest stable on nuget.org on 2026-11-06.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Also pin transitive dependencies to the versions below when they appear in the graph. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Analyzers applied to EVERY project (GlobalPackageReference = implicit PackageReference with
    PrivateAssets="all", so they never flow to consumers). Severities are configured in .editorconfig.
    StyleCop.Analyzers is intentionally NOT used: its only stable release (1.1.118, 2019) predates
    modern C#, and its useful rules overlap with dotnet format, IDE rules and the analyzers below.
  -->
  <ItemGroup Label="Analyzers (all projects)">
    <GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.321" />
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="5.0.1" />
    <GlobalPackageReference Include="Roslynator.Formatting.Analyzers" Version="5.0.1" />
    <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
  </ItemGroup>

  <ItemGroup Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="HTTP clients between modules">
    <!--
      Standard resilience pipeline for module clients (timeouts, circuit breaker, safe-method retries).
      Kept on the 10.x line (dotnet/extensions), whose net10.0 dependencies match the 10.0.x runtime
      packages above; 11.x requires newer 10.0.x runtime packages.
    -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup Label="CQRS - MediatR">
    <!--
      Pinned to 12.x on purpose: 12.5.0 is the last Apache-2.0 release. MediatR 13+ is commercially
      licensed (license key required). Do not upgrade without reviewing the license.
    -->
    <PackageVersion Include="MediatR" Version="12.5.0" />
  </ItemGroup>

  <ItemGroup Label="Validation - FluentValidation (Apache-2.0)">
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
  </ItemGroup>

  <ItemGroup Label="ASP.NET Core">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Data access - EF Core and PostgreSQL">
    <!--
      Runtime packages: Infrastructure projects only. Design/Tools: host projects only (design-time,
      PrivateAssets=all). Both rules are enforced by Architecture.Tests - see docs/database.md.
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <!--
      Transitive pin: the Npgsql provider only requires Relational >= 10.0.4, which would otherwise
      resolve to an older Relational than EF Core itself.
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <!-- Package Manager Console commands (Add-Migration, Update-Database) in Visual Studio. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.14" />
    <!-- License: PostgreSQL (permissive, MIT-like). -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Logging - Serilog (all Apache-2.0)">
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageVersion Include="Serilog.Expressions" Version="5.0.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup Label="Messaging - RabbitMQ and Kafka">
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageVersion Include="Confluent.Kafka" Version="2.16.0" />
  </ItemGroup>

  <ItemGroup Label="Health checks">
    <!--
      No 10.x release yet; 9.0.0 targets net8.0+ and runs on .NET 10.
      PostgreSQL is NOT checked with AspNetCore.HealthChecks.NpgSql: BuildingBlocks.Infrastructure has its
      own check that reuses the service's validated connection string (see docs/database.md).
    -->
    <PackageVersion Include="AspNetCore.HealthChecks.Rabbitmq" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Kafka" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- xUnit v3 on Microsoft.Testing.Platform; see "test" in global.json. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
