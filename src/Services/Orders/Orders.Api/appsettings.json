{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Expressions" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": {
      "Console": {
        "Name": "Console",
        "Args": {
          "formatter": {
            "type": "Serilog.Templates.ExpressionTemplate, Serilog.Expressions",
            "template": "{ {@t: UtcDateTime(@t), @l, @m, @mt, @x, @tr, @sp, ..@p} }\n"
          }
        }
      }
    }
  },
  "HostOptions": {
    "ShutdownTimeout": "00:00:30"
  },
  "ConnectionStrings": {
    "OrdersDb": ""
  },
  "Database": {
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 10,
    "ConnectivityProbeTimeoutSeconds": 5,
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": false
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "",
    "Password": "",
    "Exchange": "dotnet10template.events",
    "PrefetchCount": 10,
    "PublishRetryCount": 3,
    "RequeueOnException": true,
    "DeliveryLimit": 5,
    "NetworkRecoveryIntervalSeconds": 5,
    "MaxConnectRetryDelaySeconds": 30
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "BrokerAddressFamily": "Any",
    "ClientId": "",
    "SecurityProtocol": "Plaintext",
    "SaslMechanism": "Plain",
    "SaslUsername": "",
    "SaslPassword": "",
    "Producer": {
      "Acks": "All",
      "EnableIdempotence": true,
      "MessageTimeoutMs": 30000,
      "LingerMs": 5,
      "CompressionType": "Lz4"
    },
    "Consumer": {
      "GroupId": "orders",
      "AutoOffsetReset": "Earliest",
      "MaxRetryAttempts": 3,
      "RetryBackoffMs": 1000
    },
    "ProvisionTopics": false,
    "TopicDefaults": {
      "Partitions": 3,
      "ReplicationFactor": 1
    },
    "Topics": []
  },
  "AllowedHosts": "*"
}
