<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!-- Composition root for the Notifications service. -->

  <PropertyGroup>
    <!-- Development secrets: dotnet user-secrets, or right-click the project > Manage User Secrets (VS / Rider). -->
    <UserSecretsId>dotnet10template-notifications-worker</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup Label="EF Core design-time (migrations) - never shipped as a runtime dependency">
    <!-- dotnet ef (CLI, Rider) needs Design in the startup project; Visual Studio Package Manager Console needs Tools. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Notifications.Application\Notifications.Application.csproj" />
    <ProjectReference Include="..\Notifications.Infrastructure\Notifications.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\BuildingBlocks.Hosting\BuildingBlocks.Hosting.csproj" />
  </ItemGroup>

</Project>
