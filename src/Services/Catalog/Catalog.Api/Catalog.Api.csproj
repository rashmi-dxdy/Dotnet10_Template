<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Composition root for the Catalog service. -->

  <PropertyGroup>
    <!-- Development secrets: dotnet user-secrets, or right-click the project > Manage User Secrets (VS / Rider). -->
    <UserSecretsId>dotnet10template-catalog-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup Label="EF Core design-time (migrations) - never shipped as a runtime dependency">
    <!-- dotnet ef (CLI, Rider) needs Design in the startup project; Visual Studio Package Manager Console needs Tools. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Catalog.Application\Catalog.Application.csproj" />
    <ProjectReference Include="..\Catalog.Infrastructure\Catalog.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\BuildingBlocks.Hosting\BuildingBlocks.Hosting.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\BuildingBlocks.Web\BuildingBlocks.Web.csproj" />
  </ItemGroup>

</Project>
