<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Catalog module's public contract for OTHER modules: its module name and the request/response
    DTOs of its internal HTTP API (/internal/catalog/...). Plain serializable records only: no logic,
    no references to the module's own projects, no packages (enforced by Architecture.Tests).
    Other modules may reference this project, never the Catalog module's other projects. When the
    module is extracted, this project can be published as a NuGet package unchanged.
  -->

</Project>
